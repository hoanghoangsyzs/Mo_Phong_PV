APP_SECRET_KEY=change-this-secret-key
AUTH_TOKEN_TTL_SECONDS=86400
# Leave DATABASE_URL unset for local SQLite, or set a MySQL URL when deploying.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
# CORS_ORIGINS=http://localhost:5173,https://your-pages-domain.example
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

# Optional ElevenLabs text-to-speech (keep the API key server-side)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-vietnamese-female-voice-id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
