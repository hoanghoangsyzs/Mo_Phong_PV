# Set these as secrets/environment variables in your hosting provider.
APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_SECONDS=86400

# MySQL URL from your database provider. mysql:// is also accepted.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

# Exact frontend origin(s), comma-separated. No trailing slash.
CORS_ORIGINS=https://YOUR-USERNAME.github.io

# Optional services
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=12
